{
  "name": "iobroker.victron-mk2",
  "version": "0.4.0",
  "description": "Victron MultiPlus/Quattro inverter/chargers via MK2-USB or MK3-USB (VE.Bus)",
  "author": {
    "name": "joerg",
    "email": "joerg.spoerl@gmx.de"
  },
  "contributors": [],
  "homepage": "https://github.com/joergspoerl/ioBroker.victron-mk2",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "victron",
    "ve.bus",
    "mk2",
    "mk3",
    "multiplus",
    "quattro",
    "inverter",
    "charger",
    "energy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joergspoerl/ioBroker.victron-mk2.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "bufferpack": "^0.0.6",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/testing": "^6.3.2",
    "@iobroker/types": "^7.2.5",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^7.1.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^22.0.2",
    "@types/sinon-chai": "^3.2.8",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "eslint": "^8.57.1",
    "mocha": "^12.0.3",
    "proxyquire": "^2.1.3",
    "rimraf": "^6.1.4",
    "sinon": "^22.1.0",
    "sinon-chai": "^3.7.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test:ts": "mocha --config test/mocharc.custom.json \"src/**/*.test.ts\" \"src/*.test.ts\"",
    "test:package": "mocha test/package --exit",
    "test:unit": "mocha test/unit --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "test:all": "npm test && npm run check && npm run lint && npm run test:integration",
    "check": "tsc --noEmit",
    "lint": "eslint --ext .ts src/",
    "lint:fix": "eslint --ext .ts src/ --fix",
    "translate": "translate-adapter",
    "release": "release-script",
    "prepack": "npm run build"
  },
  "bugs": {
    "url": "https://github.com/joergspoerl/ioBroker.victron-mk2/issues"
  },
  "readmeFilename": "README.md"
}
