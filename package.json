{
  "name": "iobroker.victron-mk2",
  "version": "0.3.1",
  "description": "Victron MultiPlus/Quattro via MK2/VE.Bus",
  "author": {
    "name": "joerg",
    "email": "joerg.spoerl@gmx.de"
  },
  "homepage": "https://github.com/joergspoerl/ioBroker.victron-mk2",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "victron",
    "ve.bus",
    "mk2",
    "multiplus",
    "inverter",
    "charger",
    "energy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joergspoerl/ioBroker.victron-mk2"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^2.5.1",
    "bufferpack": "0.0.6",
    "serialport": "^9.2.8"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^2.2.2",
    "@iobroker/testing": "^6.3.2",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^7.1.8",
    "@types/gulp": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/proxyquire": "^1.3.31",
    "@types/serialport": "^8.0.5",
    "@types/sinon": "^22.0.2",
    "@types/sinon-chai": "^3.2.8",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "eslint": "^8.57.1",
    "gulp": "^4.0.2",
    "mocha": "^12.0.3",
    "proxyquire": "^2.1.3",
    "rimraf": "^6.1.4",
    "sinon": "^22.1.0",
    "sinon-chai": "^3.7.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*).json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf ./build",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "npm run build:ts",
    "watch:ts": "tsc -p tsconfig.build.json --watch",
    "watch": "npm run watch:ts",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:unit": "mocha test/unit --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit",
    "lint": "eslint --ext .ts src/",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/joergspoerl/ioBroker.victron-mk2/issues"
  },
  "readmeFilename": "README.md"
}
